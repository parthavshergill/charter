import Server.Bots
import Charter.Games.IslandGame

/-!
# Play a full game of the Island, for `Charter/Proofs/IslandWitness.lean`

The four seats follow the bot policy in `Server/Bots.lean`, through `Engine.step`. Bots never propose,
so this script adds one deal and one law, with the votes. It writes the events as Lean.

    lake build Server.Bots Charter.Games.IslandGame
    lake env lean --run scripts/island_game.lean search 1 50    # one line per server seed
    lake env lean --run scripts/island_game.lean emit 7 > Charter/Games/IslandGameEvents.lean

Run `emit` when the Island or the engine changes in a way that makes the kept game illegal.
-/

open Charter Charter.Engine Charter.Games.Island CharterServer.Bots

/-- One nonce per seat. -/
def nonces : List UInt64 := [1, 2, 3, 4]

/-- The deal starts on the first turn of this round or later when the seat has 2 of something. -/
def dealRound : Nat := 2

/-- The law is proposed on the first turn of this round. -/
def lawRound : Nat := 3

abbrev S := State island

/-- A game in progress: the state, the events so far (newest first), and what each is, as Lean. -/
structure Run where
  s : S
  log : List (Event × String) := []
  dealDone : Bool := false
  lawDone : Bool := false

def Run.push (r : Run) (e : Event) (src : String) : Except String Run := do
  match step island r.s e with
  | .ok s => pure { r with s, log := (e, src) :: r.log }
  | .error m => throw s!"{src}: {m}"

/-- A move as Lean. -/
def moveSrc (p : Seat) : Move → String
  | .endTurn => s!"endTurn {p}"
  | .place k (.spot v) => s!"buildAt {p} \"{k}\" {v}"
  | .place k (.link (a, b)) => s!"buildOn {p} \"{k}\" {a} {b}"
  | .bankTrade give get => s!"trade {p} \"{give}\" \"{get}\""
  | _ => "unsupported"

/-- The seat after `p` in turn order. -/
def nextSeat (p : Seat) : Seat := (p + 1) % 4

/-- The scripted deal, if the current seat can pay for it now. -/
def tryDeal (r : Run) (p : Seat) : Except String Run := do
  let names := island.resources.map (·.name)
  match names.find? (fun x => decide (2 ≤ bal r.s p x)) with
  | none => pure r
  | some x =>
    let q := nextSeat p
    let id := r.s.nextProposalId
    let r ← r.push (.propose p (.deal (twoRoundGift p q x)))
      s!".propose {p} (.deal (twoRoundGift {p} {q} \"{x}\"))"
    let r ← r.push (.sign q id) s!".sign {q} {id}"
    let r ← r.push (.sign p id) s!".sign {p} {id}"
    pure { r with dealDone := true }

/-- The scripted law: the next seats but one vote yes with the proposer, and the seat before votes no. -/
def passLaw (r : Run) (p : Seat) : Except String Run := do
  let id := r.s.nextProposalId
  let r ← r.push (.propose p (.law commonGrain)) s!".propose {p} (.law commonGrain)"
  let dissenter := (p + 3) % 4
  let r ← r.push (.vote dissenter id false) s!".vote {dissenter} {id} false"
  let r ← r.push (.vote p id true) s!".vote {p} {id} true"
  let r ← r.push (.vote (nextSeat p) id true) s!".vote {nextSeat p} {id} true"
  let r ← r.push (.vote ((p + 2) % 4) id true) s!".vote {(p + 2) % 4} {id} true"
  pure { r with lawDone := true }

/-- One step of the game: the script if it is due, and otherwise the bot's move. -/
def advance (r : Run) : Except String Run := do
  let some p := r.s.currentSeat | throw "no current seat"
  if r.s.phase == .actions && !r.dealDone && decide (dealRound ≤ r.s.round) then
    let r' ← tryDeal r p
    if r'.dealDone then return r'
  if r.s.phase == .actions && !r.lawDone && decide (lawRound ≤ r.s.round) then
    return ← passLaw r p
  let legal := legalMoves island r.s p
  let m := if r.s.phase == .setup then setupMove r.s legal else actionMove r.s p legal
  match r.push (.move p m) (moveSrc p m) with
  | .ok r' => pure r'
  | .error _ => r.push (.move p .endTurn) (moveSrc p .endTurn)

/-- Play until the game ends. A game has at most a few thousand events. -/
def playOut (seed : UInt64) : Except String Run := do
  let mut r : Run := { s := initialState island 4 seed nonces }
  for _ in [0:5000] do
    if r.s.phase == .ended then return r
    r ← advance r
  throw "the game did not end"

/-- Each seat's built pieces and points. -/
def scores (s : S) : String :=
  ", ".intercalate <| s.turnOrder.map fun p =>
    s!"seat {p}: {s.pointsOf p} points, {(s.pieces.filter (·.owner == p)).length} pieces"

def summary (seed : UInt64) (r : Run) : String :=
  let s := r.s
  s!"Server seed {seed}: {r.log.length} events, round {s.round}, winner {repr s.winner}, " ++
  s!"deals {s.dealsStarted}, laws {s.laws.map (·.1)}, {scores s}"

/-- The Lean file, one line per turn. -/
def render (seed : UInt64) (r : Run) : String := Id.run do
  let header :=
    s!"import Charter.Games.IslandGame\n\n/-!\n# The events of one full game of the Island\n\n" ++
    s!"Written by `scripts/island_game.lean`. Do not edit this file by hand.\n\n" ++
    s!"{summary seed r}. Nonces {nonces}.\n-/\n\n" ++
    "namespace Charter.Games.Island\n\nopen Charter\n\n" ++
    "/-- A full game of the Island, one line per turn. -/\ndef islandGameEvents : List Event :=\n"
  let mut lines : Array String := #[]
  let mut cur : Array String := #[]
  for (e, src) in r.log.reverse do
    cur := cur.push src
    match e with
    | .move _ .endTurn =>
      lines := lines.push (", ".intercalate cur.toList)
      cur := #[]
    | _ => pure ()
  unless cur.isEmpty do
    lines := lines.push (", ".intercalate cur.toList)
  let body := "\n  , ".intercalate lines.toList
  return header ++ "  [ " ++ body ++ " ]\n\nend Charter.Games.Island\n"

def main (args : List String) : IO UInt32 := do
  match args with
  | ["search", a, b] =>
    for seed in [a.toNat!:b.toNat! + 1] do
      match playOut (UInt64.ofNat seed) with
      | .ok r => IO.println (summary (UInt64.ofNat seed) r)
      | .error m => IO.println s!"seed {seed}: {m}"
    return 0
  | ["emit", a] =>
    match playOut (UInt64.ofNat a.toNat!) with
    | .ok r =>
      IO.print (render (UInt64.ofNat a.toNat!) r)
      return 0
    | .error m =>
      IO.eprintln m
      return 1
  | _ =>
    IO.eprintln "usage: island_game.lean search FROM TO | emit SEED"
    return 2
